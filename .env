WECHAT_FAKEID=''
WECHAT_NICKNAME='AI大娘'
WECHAT_EXPIRE_TIME='1785892390511'

# 限频配置 (单位: 次/分钟 或 秒)
RATE_LIMIT_GLOBAL=10
RATE_LIMIT_PER_IP=5
RATE_LIMIT_ARTICLE_INTERVAL=3

# Webhook 通知 (留空则禁用，支持企业微信群机器人)
WEBHOOK_URL=
# 同一事件通知最小间隔（秒），防止重复轰炸
WEBHOOK_NOTIFICATION_INTERVAL=300

# RSS 订阅配置
# 轮询间隔（秒），默认 3600（1 小时）
RSS_POLL_INTERVAL=3600
# 每次轮询拉取的文章批次数，默认 10（高频更新的公众号可适当增大）
ARTICLES_PER_POLL=10
# RSS 轮询时是否获取完整文章内容（true/false），默认 true
# ⚠️ 启用时强烈建议配置下方的 PROXY_URLS，避免账号被微信风控
RSS_FETCH_FULL_CONTENT=true

# SOCKS5 代理池（⚠️ 启用RSS完整内容时强烈建议配置，避免账号风控）
# 用途：分散请求 IP，配合 Chrome TLS 指纹模拟，有效规避微信封控
# 不配置代理直连微信可能导致：频繁验证、账号限制、IP 封禁
# 支持 SOCKS5 代理，多个用逗号分隔，建议 2-3 个即可
# 示例: socks5://ip1:1080,socks5://ip2:1080,socks5://user:pass@ip3:1080
# 留空则直连（仅适用于少量订阅或禁用 RSS_FETCH_FULL_CONTENT 的情况）
PROXY_URLS=

# 服务配置
# 网站URL(用于RSS图片代理,必须配置为实际访问地址)
# 例如: http://你的IP:5000 或 https://你的域名.com
SITE_URL=http://localhost:5000
PORT=5000
HOST=0.0.0.0
DEBUG=false

# 数据库路径（默认 ./data/rss.db，Docker 环境一般无需修改）
# RSS_DB_PATH=/app/data/rss.db


DB_HOST=122.51.246.198
DB_PORT=3306
DB_DATABASE=we_mp
DB_USERNAME=root
DB_PASSWORD=lifl1234

# 豆包/火山引擎联网搜索 API Key（Custom 版 web 搜索）
DOUBAO_API_KEY=9KjGFU7Ixfs3xfuAKMkyfAsWRa9HlNKi

# newsnow 本地实例地址（热榜聚合，需先启动：cd ~/newsnow && pnpm dev）
NEWSNOW_BASE_URL=http://localhost:5173

# Chrome CDP 地址（抖音创作者中心数据采集，需 Chrome 调试模式）
CDP_BASE_URL=http://localhost:9222

# 邮件通知（凭证失效等告警，163 SMTP）
MAIL_HOST=smtp.163.com
MAIL_PORT=465
MAIL_SSL=true
MAIL_USER=17682167979@163.com
MAIL_PASS=KN2VK3BX66jNggMi
MAIL_FROM=17682167979@163.com
MAIL_TO=17682167979@163.com
